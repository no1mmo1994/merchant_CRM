# ── PulseOrder .env (copy to .env and fill in) ───────────────────────────────────
# Phase 03 ships in LOCAL mode by default.  Copy this file to .env and
# customise as needed.  Never commit .env to source control.

# ── Mode ─────────────────────────────────────────────────────────────────────────
# "local" = developer mode (no HTTPS, relaxed validation)
# "deploy" = production mode (requires session_secret + admin_password_hash)
APP_MODE=local

# ── Server ─────────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite (default, fine for single-instance deployments)
DATABASE_URL=sqlite:///./data/grab.db
# PostgreSQL example (Phase 04+):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/pulseorder

# ── Security — LOCAL mode ──────────────────────────────────────────────────────
# Fernet key for encrypting Grab tokens at rest.
# Generate with: python -c "from app.core.config import Settings; print(Settings.generate_fernet_key())"
TOKEN_ENCRYPTION_KEY=

# ── Security — DEPLOY mode only ────────────────────────────────────────────────
# Generate a session secret with: python -c "from app.core.config import Settings; print(Settings.generate_session_secret())"
SESSION_SECRET=
# bcrypt hash of the admin password.
# Generate with: python -c "from app.core.security import hash_password; print(hash_password('your-strong-password'))"
ADMIN_PASSWORD_HASH=

# ── CORS ────────────────────────────────────────────────────────────────────────
# Allowlist for browser requests (comma-separated in the env var, or repeat the key)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── HTTPS ───────────────────────────────────────────────────────────────────────
# Set to true in deploy; FastAPI/starlette handles TLS termination upstream.
# REQUIRE_HTTPS=false

# ── Rate limiting ───────────────────────────────────────────────────────────────
# Maximum authenticated requests per minute per IP.
# RATE_LIMIT_PER_MINUTE=60
