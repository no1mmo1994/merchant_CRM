# ============================================
# PulseOrder — Environment Variables
# ============================================
# Copy this file to `.env` and fill in real values.
# In a local dev environment, only TOKEN_ENCRYPTION_KEY is required.
# For deploy mode, see README.md for full requirements.

# ------------------------------------------
# Application Mode
# ------------------------------------------
# `local`  — bind to 127.0.0.1, no HTTPS, no admin password (dev-friendly)
# `deploy` — bind to 0.0.0.0, HTTPS required, admin password mandatory
APP_MODE=local

# ------------------------------------------
# Backend API
# ------------------------------------------
# Dev port is 8123, NOT 8000 — Windows 11 reserves/excludes 8000
# (Hyper-V, WSL2 NAT, Defender) which causes `[WinError 10013]` on bind.
# Production (Dockerfile, nginx) stays on 8000.
API_HOST=127.0.0.1
API_PORT=8123
DATABASE_URL=sqlite:///data/grab.db

# Fernet symmetric key for encrypting Grab auth tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be 32 url-safe base64 bytes (44 chars). Keep it secret and stable.
TOKEN_ENCRYPTION_KEY=replace-this-with-a-fresh-fernet-key

# ------------------------------------------
# Frontend Web
# ------------------------------------------
WEB_PORT=3000
# The full URL where the backend API is reachable from the browser.
# In local dev, Next.js proxies /api/* to this URL automatically.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8123

# ------------------------------------------
# Auth (deploy mode only)
# ------------------------------------------
# Required when APP_MODE=deploy. Ignored in local mode.
# Used to seed the admin login; user will change this on first login.
ADMIN_PASSWORD=change-me-in-deploy-mode

# Used to sign session cookies. Random 32+ bytes.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-this-with-a-random-secret

# ------------------------------------------
# CORS (deploy mode only)
# ------------------------------------------
# Comma-separated list of allowed frontend origins.
# Example: CORS_ORIGINS=["https://pulseorder.yourdomain.com"]
CORS_ORIGINS=["http://localhost:3000"]

# ------------------------------------------
# Server hardening
# ------------------------------------------
# How many requests per minute per IP for /api/auth/* endpoints.
RATE_LIMIT_PER_MINUTE=60
# Set to true in deploy mode to enforce HTTPS-only cookies.
REQUIRE_HTTPS=false
